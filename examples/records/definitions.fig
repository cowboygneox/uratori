# ---- records.fig ----
# A patient's uploaded chart -- years of pages, scanned or typed -- read
# as facts (documents-plan-v3, D1/D4/D5). This is the worked example
# docs/documents.md points at: upload a bundle, classify its pages, read
# vitals off the ones that are vitals, and let height carry forward on
# the days nobody re-measured it. `examples/records/load.py` teaches and
# runs this; `examples/records/author.py` is the authoring loop that
# wrote `measurement`'s alternatives in the first place.

# -------------------------------------------------------------- the world --

# A patient's uploaded records, one file at a time. The bytes live beside
# the fact (D1) -- this declaration only names the shape.
fact medical_record as document:
    name title

# One page of one record. No block: every field a page carries is the
# shape's own (D1), never a host's.
fact medical_record_page as page of medical_record

# Who a page says it is about -- the identifier a chart's own system
# prints, never a name. Names collide and are mistyped; a medical record
# number does not, which is the entire reason this is its own extract
# rather than a guess folded into `measurement` below. Read once, from
# the printed identifier; every other extract on this page trusts it
# rather than re-reading the page for itself.
extract page_identity from medical_record_page:
    patient_id = text after any of ["MRN:", "Patient ID:"]

# What a page is, read from its own words rather than asserted by a
# provider -- a scanned bundle has no folder structure to trust. A page
# is "vitals" if it says so anywhere on it -- a ladder, first match wins,
# searched over the whole page rather than one line, because the trigger
# word and the vitals themselves are rarely on the same line.
extract page_class from medical_record_page:
    type = "vitals" if page contains any of ["VITAL SIGNS", "Vitals", "Wt:"]

filter page_class.vitals keyed as medical_record_page where type == "vitals"

# One set of vitals read off one page -- a record per page, or per row on
# a flowsheet (`many by row`, below). Every spelling this bundle's
# templates actually print for weight and height -- authored by reading
# a sample of pages and listing what each one says (D4's authoring
# loop). `author.py` is that loop's second half: handed the failures
# this first draft left on a bundle it had not seen yet, it proposes the
# alternative or matcher to add, over the page words that broke it,
# never a guess made without them.
extract measurement from medical_record_page:
    over page_class.vitals
    many by row up to 5
    patient_id  = page_identity.patient_id
    measured_at = date after any of ["Date:", "Visit date", "DOS"]
    weight_kg   = number after any of ["Weight:", "Wt:", "WEIGHT (kg)"] in kg or lb
    height_cm   = number after any of ["Ht:", "Height"] in cm or in or ft_in

# Who vitals are tracked for. Nothing patient-specific lives in the
# engine (documents-plan-v3, D5): `patient` is this host's own roster,
# pushed through the ordinary facts route the same as any provider
# pushes any fact. `load.py` pushes it from the same invented roster
# `generate.py` wrote the charts for.
fact patient:
    mrn as text

group measurement.by_patient_day from (patient_id, measured_at by day in "UTC")
filter measurement.weighed where weight_kg is set
filter measurement.heighted where height_cm is set

# The height in force each day: the latest one measured, carried across
# every day nobody re-measured it. Most charts measure height once and
# weight at every visit after -- this is the figure that makes that true
# of the numbers too, not just of the chart.
figure patient.height bucketed:
    display "{patient} height"
    unit decimal
    depends:
        measured = measurement.by_patient_day:{patient} & measurement.heighted
    calculate:
        latest(measurement.height_cm over measured) carried forward

# Weight on each day one was actually taken -- no carrying: a day nobody
# weighed the patient has no weight, not yesterday's.
figure patient.weight bucketed:
    display "{patient} weight"
    unit decimal
    depends:
        weighed = measurement.by_patient_day:{patient} & measurement.weighed
    calculate:
        latest(measurement.weight_kg over weighed)

# Body-mass index on each day, from that day's weight and the height in
# force. Arithmetic has one home (D5) -- this figure is it, never a
# second place a chart's own flowsheet or a dashboard recomputes it.
figure patient.bmi bucketed:
    display "{patient} BMI"
    unit decimal
    calculate:
        patient.weight:{bucket} / ((patient.height:{bucket} / 100) * (patient.height:{bucket} / 100))

# A second reader over the vitals each page prints (documents-plan-v3,
# D6) -- told which fields `measurement` declares (name, type, unit, and
# each field's own `#` prose, when it has one), never its alternatives
# or its current value. Run under the fake provider in this example and
# its tests
# (`URATORI_AUDIT_PROVIDER=fake`); a real deployment sets it to "claude"
# and reads `docs/setup.md`'s "Audits and PHI egress" first.
audit medical_record_page.vitals_audit:
    verifies page_identity, measurement
    model "claude-opus-5-5"
    read:
        document = medical_record.title
    context "This chart's pages may print weight in pounds or kilograms, and height in centimetres, inches, or feet and inches. This is {document}."
    display "{medical_record_page} {value}"
